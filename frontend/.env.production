# Vide : le site appelle /api sur son propre domaine, redirigé vers Render par netlify.toml.
VITE_API_URL=

# --- Mise en ligne (voir src/lib/site.js) ---
# Adresse publique du site, sans / final (ex. https://cineviseur.fr). Sert au sitemap et aux liens de partage.
VITE_SITE_URL=
# Pages légales : éditeur, adresse, email de contact, hébergeur.
VITE_SITE_EDITOR=
VITE_SITE_ADDRESS=
VITE_CONTACT_EMAIL=
VITE_SITE_HOST=
# Mesure d'audience (optionnelle, avec bannière de consentement) : plausible ou umami.
VITE_ANALYTICS_PROVIDER=
VITE_ANALYTICS_ID=
VITE_ANALYTICS_SRC=
